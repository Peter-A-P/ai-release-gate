# Private working notes, never committed
CLAUDE.local.md

# Secrets
.env
.env.*
*.key

# Python
__pycache__/
*.py[cod]
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
dist/
build/
*.egg-info/

# Development caches (the monthly run never caches)
.cache/
drift/dev-cache/

# OS and editors
.DS_Store
Thumbs.db
.vscode/
.idea/

# Development ledger for the runner (the monthly ledgers under drift/runs/<month>/ are committed)
drift/runs/dev-ledger.sqlite*
drift/runs/*/*/raw/*.tmp

# SQLite's scratch files beside a ledger. `-wal` holds transactions not yet folded in and `-shm`
# is its shared index; both are deleted when the database closes cleanly, and neither is part of
# the record. An open ledger leaves them lying next to the committed one, where a `git add -A`
# picks them up, which is how 128 of them reached the history already.
drift/runs/*/*/ledger.sqlite-wal
drift/runs/*/*/ledger.sqlite-shm

# Held-out items (PLAN.md section 2.5): the items stay outside the repository until month 12,
# and boundary's raw store for their calls is never committed. Belt and braces.
heldout-*.jsonl
drift/runs/*/*/raw-heldout/

# The Rule C judge experiment keeps its raw store like the record does; only temp files go.
drift/experiments/*/*/raw/*.tmp

# Part B's gold set keeps its ledger like the drift record does: the database is committed,
# SQLite's scratch sidecars are not, and boundary's raw store keeps only finished files.
gate/gold/ledger.sqlite-wal
gate/gold/ledger.sqlite-shm
gate/gold/raw/*.tmp
gate/gold/raw-judge/*.tmp
