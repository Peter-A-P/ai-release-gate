# Every text file is stored and checked out with LF, whatever the editor's platform.
# On 2026-09-23 a checkout showed 274 files modified that differed in nothing once line
# endings were ignored, the same noise that tracking the SQLite sidecars once produced.
* text=auto eol=lf

# The ledgers are the record. Git must never convert or diff them as text.
*.sqlite binary
